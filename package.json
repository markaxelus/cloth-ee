{
  "name": "cloth-ee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:pose": "node scripts/setup-pose.mjs",
    "check:live": "node --env-file-if-exists=.env scripts/check-live.mjs",
    "town:accuracy": "node scripts/town-accuracy.mjs",
    "usage": "node --env-file-if-exists=.env scripts/usage-summary.mjs"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0"
  }
}
