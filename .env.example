# Offline sample catalog and rule-based stylist run without any keys.
HOST=0.0.0.0
PORT=3000
CATALOG_MODE=demo
OMNI_MODE=demo
# Add Expo web origins only if using Expo web. Native apps send no Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Real Shopify Storefront API. Do not put these in mobile EXPO_PUBLIC variables.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Use "public" for a public Storefront access token, "private" for a private one.
SHOPIFY_TOKEN_KIND=public

# For the Huawei track, get the approved endpoint/model/key from the sponsor.
# The adapter implements OpenAI-compatible Qwen Omni Chat Completions with SSE.
# Set the FULL /v1/chat/completions URL, not just the service base URL.
OMNI_CHAT_URL=
OMNI_MODEL=
OMNI_API_KEY=
# A model supporting image + audio in one request is required (e.g. Qwen3.5 Omni).
# This default avoids silently claiming compatibility with an unknown model.
# The town scan works either way: when false it sends image and audio as separate messages,
# which qwen3.5-omni-flash transcribed more reliably than one combined message.
OMNI_COMBINED_INPUT=false
OMNI_TIMEOUT_MS=45000
# Appends one JSON line per live call (tokens, purpose, key suffix only). `npm run usage` summarises it.
OMNI_USAGE_LOG=artifacts/yibu_api_calls.jsonl
# Native Expo recordings are converted to mono WAV. Install ffmpeg for those.
FFMPEG_PATH=ffmpeg
